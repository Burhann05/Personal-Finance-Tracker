import csv
import os
from datetime import datetime
import pandas as pd

DATA_FILE = "expenses.csv"


# ---------------------------------------
# 1. CHECK IF CSV EXISTS AND LOAD IT
# ---------------------------------------
def initialize_file():
    if not os.path.exists(DATA_FILE):
        # If file missing, create header
        with open(DATA_FILE, "w", newline="") as file:
            writer = csv.writer(file)
            writer.writerow(["Date", "Category", "Description", "Amount"])
        print("expenses.csv file created.")
    else:
        print("Loaded existing expenses.csv")


# ---------------------------------------
# 2. ADD AN EXPENSE ENTRY
# ---------------------------------------
def add_expense():
    date_input = input("Enter date (YYYY-MM-DD) or press Enter for today: ")

    if date_input.strip() == "":
        date_input = datetime.now().strftime("%Y-%m-%d")

    category = input("Enter category (Food, Travel, Bills, Shopping, etc.): ")
    description = input("Enter description: ")

    try:
        amount = float(input("Enter amount: "))
    except ValueError:
        print("Invalid amount! Try again.")
        return

    with open(DATA_FILE, "a", newline="") as file:
        writer = csv.writer(file)
        writer.writerow([date_input, category, description, amount])

    print("Expense added successfully!")


# ---------------------------------------
# 3. GENERATE MONTHLY REPORT
# ---------------------------------------
def generate_monthly_report():
    df = pd.read_csv(DATA_FILE)

    if df.empty:
        print("No data found in expenses.csv.")
        return

    month = input("Enter month (1-12): ")
    year = input("Enter year (YYYY): ")

    df["Date"] = pd.to_datetime(df["Date"])
    filtered = df[
        (df["Date"].dt.month == int(month)) & (df["Date"].dt.year == int(year))
    ]

    if filtered.empty:
        print("No expenses found for this month.")
        return

    print("\n===== Monthly Expenses =====")
    print(filtered.to_string(index=False))

    print("\n===== Spending by Category =====")
    print(filtered.groupby("Category")["Amount"].sum())

    total = filtered["Amount"].sum()
    print("\nTotal Spending This Month:", total)

    # Save monthly report
    report_filename = f"report_{year}_{month}.csv"
    filtered.to_csv(report_filename, index=False)
    print(f"\nMonthly report saved as: {report_filename}")


# ---------------------------------------
# 4. DISPLAY MENU
# ---------------------------------------
def menu():
    initialize_file()

    while True:
        print("\n========== Personal Finance Tracker ==========")
        print("1. Add Expense")
        print("2. Generate Monthly Report")
        print("3. Exit")
        choice = input("Enter your choice: ")

        if choice == "1":
            add_expense()
        elif choice == "2":
            generate_monthly_report()
        elif choice == "3":
            print("Goodbye!")
            break
        else:
            print("Invalid option. Try again!")



menu()
